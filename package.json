{
  "name": "tanstack-fetch",
  "version": "2.2.0",
  "description": "The fetch client that speaks queryFn: returns data, throws typed errors, respects AbortSignal. SSR, SSE, WebSocket, upload and React / Vue / Solid / Angular / Svelte adapters. Independent project, not affiliated with TanStack.",
  "license": "MIT",
  "author": {
    "name": "Mohammad Garmabi",
    "email": "mwmdgmb@gmail.com",
    "url": "https://github.com/mohamadgarmabi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamadgarmabi/tanstack-fetch.git"
  },
  "bugs": {
    "url": "https://github.com/mohamadgarmabi/tanstack-fetch/issues"
  },
  "homepage": "https://mohamadgarmabi.github.io/tanstack-fetch/",
  "keywords": [
    "fetch",
    "http-client",
    "api-client",
    "typescript",
    "tanstack-query",
    "react-query",
    "ssr",
    "sse",
    "server-sent-events",
    "websocket",
    "ndjson",
    "interceptor",
    "file-upload",
    "abortsignal",
    "trpc"
  ],
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tanstack-fetch": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sse": {
      "import": {
        "types": "./dist/sse.d.ts",
        "default": "./dist/sse.js"
      },
      "require": {
        "types": "./dist/sse.d.cts",
        "default": "./dist/sse.cjs"
      }
    },
    "./full": {
      "import": {
        "types": "./dist/sse.d.ts",
        "default": "./dist/sse.js"
      },
      "require": {
        "types": "./dist/sse.d.cts",
        "default": "./dist/sse.cjs"
      }
    },
    "./live": {
      "import": {
        "types": "./dist/live.d.ts",
        "default": "./dist/live.js"
      },
      "require": {
        "types": "./dist/live.d.cts",
        "default": "./dist/live.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.js"
      },
      "require": {
        "types": "./dist/plugins.d.cts",
        "default": "./dist/plugins.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./solid": {
      "import": {
        "types": "./dist/solid.d.ts",
        "default": "./dist/solid.js"
      },
      "require": {
        "types": "./dist/solid.d.cts",
        "default": "./dist/solid.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.ts",
        "default": "./dist/svelte.js"
      },
      "require": {
        "types": "./dist/svelte.d.cts",
        "default": "./dist/svelte.cjs"
      }
    },
    "./angular": {
      "import": {
        "types": "./dist/angular.d.ts",
        "default": "./dist/angular.js"
      },
      "require": {
        "types": "./dist/angular.d.cts",
        "default": "./dist/angular.cjs"
      }
    },
    "./trpc": {
      "import": {
        "types": "./dist/trpc.d.ts",
        "default": "./dist/trpc.js"
      },
      "require": {
        "types": "./dist/trpc.d.cts",
        "default": "./dist/trpc.cjs"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools.d.ts",
        "default": "./dist/devtools.js"
      },
      "require": {
        "types": "./dist/devtools.d.cts",
        "default": "./dist/devtools.cjs"
      }
    },
    "./mock": {
      "import": {
        "types": "./dist/mock.d.ts",
        "default": "./dist/mock.js"
      },
      "require": {
        "types": "./dist/mock.d.cts",
        "default": "./dist/mock.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test example",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/size.mjs",
    "example": "tsx example/run.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "docs:dev": "npm run skills:sync && npm run dev --prefix website",
    "docs:build": "npm run skills:sync && npm run build --prefix website",
    "docs:preview": "npm run preview --prefix website",
    "skills:sync": "rm -rf website/public/skills/tanstack-fetch && mkdir -p website/public/skills && cp -R .agents/skills/tanstack-fetch website/public/skills/"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "@trpc/client": ">=10",
    "@trpc/server": ">=10",
    "react": ">=18",
    "solid-js": ">=1.8",
    "svelte": ">=4",
    "vue": ">=3.3",
    "yaml": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "yaml": {
      "optional": true
    },
    "@trpc/client": {
      "optional": true
    },
    "@trpc/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^19.2.25",
    "@eslint/js": "^9.36.0",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "eslint": "^9.36.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9.17",
    "svelte": "^5.57.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.43",
    "yaml": "^2.8.1"
  }
}
