{
  "name": "tanstack-fetch",
  "version": "1.3.0",
  "description": "React Query / TanStack Query fetch client — typed errors, AbortSignal, SSR, SSE, upload. Lightweight axios/ky alternative (~3.5KB).",
  "license": "MIT",
  "author": {
    "name": "Mohammad Garmabi",
    "email": "mwmdgmb@gmail.com",
    "url": "https://github.com/mohamadgarmabi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamadgarmabi/tanstack-fetch.git"
  },
  "bugs": {
    "url": "https://github.com/mohamadgarmabi/tanstack-fetch/issues"
  },
  "homepage": "https://mohamadgarmabi.github.io/tanstack-fetch/",
  "keywords": [
    "Mohammad Garmabi",
    "mohammad garmabi",
    "fetch",
    "http-client",
    "http",
    "api-client",
    "rest-client",
    "typescript",
    "tanstack",
    "tanstack-query",
    "tanstack-react-query",
    "react-query",
    "@tanstack/react-query",
    "queryfn",
    "react",
    "nextjs",
    "next.js",
    "ssr",
    "server-side-rendering",
    "edge",
    "sse",
    "server-sent-events",
    "streaming",
    "openapi",
    "openapi-codegen",
    "codegen",
    "interceptor",
    "middleware",
    "axios-alternative",
    "axios",
    "ky",
    "ofetch",
    "multipart",
    "formdata",
    "file-upload",
    "upload-progress",
    "abortsignal",
    "fetch-wrapper",
    "react-query-fetch-client",
    "tanstack-query-fetch",
    "trpc",
    "@trpc/client",
    "tanstack-router",
    "tanstack-start"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tanstack-fetch": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "import": "./dist/sse.js",
      "require": "./dist/sse.cjs"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js",
      "require": "./dist/plugins.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./trpc": {
      "types": "./dist/trpc.d.ts",
      "import": "./dist/trpc.js",
      "require": "./dist/trpc.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test example",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/size.mjs",
    "example": "tsx example/run.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "docs:dev": "npm run dev --prefix website",
    "docs:build": "npm run build --prefix website",
    "docs:preview": "npm run preview --prefix website"
  },
  "peerDependencies": {
    "@trpc/client": ">=10",
    "react": ">=18",
    "yaml": "^2.0.0",
    "@trpc/server": ">=10"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "yaml": {
      "optional": true
    },
    "@trpc/client": {
      "optional": true
    },
    "@trpc/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@trpc/client": "^11.19.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1",
    "@trpc/server": "^11.19.0"
  }
}
