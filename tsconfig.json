{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "tanstack-fetch": ["./src/index.ts"],
      "tanstack-fetch/sse": ["./src/sse/index.ts"],
      "tanstack-fetch/plugins": ["./src/plugins-entry.ts"],
      "tanstack-fetch/react": ["./src/react/index.ts"]
    }
  },
  "include": ["src", "test", "example", "vitest.config.ts"]
}
