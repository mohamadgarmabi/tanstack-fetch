       ...(opts as any),\n        req,\n        res,\n        path,\n      });\n    }).catch(\n      internal_exceptionHandler({\n        req,\n        res,\n        path,\n        ...opts,\n      }),\n    );\n  };\n}\n"],"mappings":";;;;;AAgCA,SAAgB,qBACd,MACgB;CAChB,OAAO,OAAO,KAAK,QAAQ;EACzB,IAAI,OAAO;EAEX,MAAM,IAAI,YAAY;GACpB,OAAO,UAAU;IACf,IAAI,OAAO,IAAI,MAAM,YAAY,UAC/B,OAAO,IAAI,MAAM;IAEnB,IAAI,MAAM,QAAQ,IAAI,MAAM,OAAO,GACjC,OAAO,IAAI,MAAM,OAAO,CAAC,KAAK,GAAG;IAEnC,MAAM,IAAI,UAAU;KAClB,SACE;KACF,MAAM;IACR,CAAC;GACH,CAAC;GAED,MAAM,uBAAA,eAAA,eAAA,CAAA,GACA,IAAA,GAAA,CAAA,GAAA;IACJ;IACA;IACA;GACF,CAAA,CAAC;EACH,CAAC,CAAC,CAAC,MACD,0BAAA,eAAA;GACE;GACA;GACA;EACG,GAAA,IACL,CAAC,CACH;CACF;AACF"}